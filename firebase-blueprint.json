{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with account details and wallet balance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "balance": { "type": "number" },
        "bio": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "balance"]
    },
    "Task": {
      "title": "Marketplace Task",
      "description": "A task posted by a user for others to complete.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "completed", "cancelled"] },
        "creatorId": { "type": "string" },
        "workerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "price", "status", "creatorId"]
    },
    "Submission": {
      "title": "Task Submission",
      "description": "Proof of task completion submitted by a worker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "workerId": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "feedback": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Transaction": {
      "title": "Wallet Transaction",
      "description": "Record of money entering or leaving the wallet.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "earning", "payment"] },
        "method": { "type": "string", "enum": ["JazzCash", "EasyPaisa", "PayPal", "Internal"] },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "taskId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatRoom": {
      "title": "Chat Room",
      "description": "A private chat between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string", "format": "date-time" },
        "lastMessageSenderId": { "type": "string" }
      }
    },
    "Message": {
      "title": "Chat Message",
      "description": "An individual message in a chat room.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Review": {
      "title": "User Review",
      "description": "Rating and feedback for a user after task completion.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "reviewerId": { "type": "string" },
        "revieweeId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Notification": {
      "title": "User Notification",
      "description": "Alert for task updates, messages, or wallet activity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks in the marketplace."
    },
    "/tasks/{taskId}/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Submissions for a specific task."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Wallet transactions."
    },
    "/chatRooms/{roomId}": {
      "schema": "ChatRoom",
      "description": "Chat conversations."
    },
    "/chatRooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a chat room."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Task-related reviews."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications."
    }
  }
}
